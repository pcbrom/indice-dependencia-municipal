    "gestor": "para reduzir a exposição a repasse, o FPM está acima do porte e a receita própria abaixo"
   },
   "autonomia": {
    "rotulo": "autonomia relativa",
    "condicao": "receita/PIB igual ou acima da mediana e FPM igual ou abaixo",
    "leitura": "a arrecadação própria acompanha ou supera o porte e o repasse fica abaixo dos pares",
    "gestor": "base fiscal já alinhada ao porte, sem distância a fechar na comparação por tamanho"
   },
   "amplo_repasse_alto": {
    "rotulo": "orçamento amplo com repasse alto",
    "condicao": "receita/PIB igual ou acima da mediana e FPM acima",
    "leitura": "a receita frente à economia supera o porte, mas o repasse também pesa mais que nos pares",
    "gestor": "a receita própria acompanha o porte, mas o peso do repasse é uma referência a acompanhar"
   }
  },
