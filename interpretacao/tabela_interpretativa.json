    "gestor": "para fortalecer a receita própria, a distância ao porte está na base própria, não na transferência"
   },
   "sobre_dependencia": {
    "rotulo": "sobre-dependência de repasse",
    "condicao": "FPM acima da mediana do porte e receita/PIB abaixo da mediana",
